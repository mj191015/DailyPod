	let PICKER_VIEW_HEIGHT:CGFloat = 80
2. 피커 뷰의 높이를 전달할 키퍼 뷰 델리게이트 메서드를 numberOfComponents 메서드 아래에 추가합니다. 

//returns height of for each component
func pickerView(_ pickerView: UIPickerView, rowHeightForComponent component : Int) -> CGFloat {
    return PICKER_VIEW_HEIGHT
}

피커 뷰에게 컴포넌트를 높이를 정수 값으로 넘겨주는 델리게이트 메서드입니다. 여기서는 PICKER_VIEW_HEIGHT 의 값을 80 을 넘겨 줍니다. 

